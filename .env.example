VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Laravel marketplace origin (used by auth footer links: /for-dealers, privacy, etc.)
# Production example: https://bilskyen.dk
# If omitted in production, the panel derives it from the current host (panel.* → apex).
VITE_MARKETPLACE_URL=http://localhost:8000

# Panel UI locale: `en` or `da`. Omit in production (defaults to Danish).
# VITE_APP_LOCALE=en

# Cloudflare Turnstile site key (same as backend TURNSTILE_SITE_KEY). Empty = skip in local.
# VITE_TURNSTILE_SITE_KEY=
